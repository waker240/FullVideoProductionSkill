# Copy to the VIDEO PROJECT's .env and keep it untracked. Never paste keys in chat.
FISH_API_KEY=
FISH_REFERENCE_ID=
FISH_MODEL=s2.1-pro-free

# Optional: word timestamps and image generation have separate API billing.
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=whisper-1
# Choose a GPT Image model available to your account. No model is selected here.
OPENAI_IMAGE_MODEL=

# Optional user-owned OpenAI-compatible transcription server.
# If set, OPENAI_API_KEY is never sent to this endpoint.
# WHISPER_API=https://your-transcription-service.example/v1/audio/transcriptions
# WHISPER_API_KEY=

# Optional local media configuration, relative to the project where documented.
# MEDIA_USE_SKILL_DIR=/path/to/.agents/skills/media-use
# MEDIA_CATALOG=mediaReview/my-library/catalog.json
# MEDIA_USE_GLOBAL_CACHE_DIR=/path/to/user-owned/cache
