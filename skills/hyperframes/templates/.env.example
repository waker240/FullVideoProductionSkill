# Copy into the VIDEO PROJECT as .env. Existing environment variables win.
# Fill only the capabilities you use. Never commit the completed .env.

# Fish Audio developer API: required only for generated narration.
FISH_API_KEY=
FISH_REFERENCE_ID=
FISH_MODEL=s2.1-pro-free

# OpenAI developer API: required for the included transcription/image adapters.
# A ChatGPT/Codex subscription is not an API key or API credit balance.
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=whisper-1
# Select a model available to your account. No desktop model ID is assumed.
OPENAI_IMAGE_MODEL=

# Optional: YOUR transcription endpoint, replacing the official route.
# Leave empty to use the official OpenAI adapter. Do not put keys in the URL.
WHISPER_API=
WHISPER_API_KEY=

# Optional media-use locations. Do not point at someone else's private library.
MEDIA_USE_SKILL_DIR=
MEDIA_USE_GLOBAL_CACHE_DIR=
MEDIA_CATALOG=

# Optional ngrok authentication for explicitly requested public reviews.
# Local preview and local review do not require ngrok or an account.
NGROK_AUTHTOKEN=
